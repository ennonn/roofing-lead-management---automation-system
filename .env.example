# ==============================================================================
# Roofing Lead Management & Automation System — Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Update placeholder values before running the application.
# 3. NEVER commit the real .env file or production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Frontend public URL for CORS and cookie SameSite matching
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database (Drizzle ORM & Session Store)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=roofing_leads
POSTGRES_USER=roofing_user
POSTGRES_PASSWORD=replace_with_strong_db_password_here

# Full connection string used by Drizzle ORM and migration runner
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# Session & Security Settings
# ------------------------------------------------------------------------------
# Session secret must be a cryptographically random string (min 32 characters in production)
SESSION_SECRET=replace_with_random_32_character_string_for_session_cookie_encryption
SESSION_NAME=roofing_sid
SESSION_MAX_AGE_HOURS=24
# Set to 'true' in production behind HTTPS reverse proxy
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# ------------------------------------------------------------------------------
# Initial Seed User (No Public Registration)
# ------------------------------------------------------------------------------
# Used only during initial database seed to provision the primary business owner account
INITIAL_OWNER_EMAIL=owner@example-roofing.com
INITIAL_OWNER_PASSWORD=replace_with_initial_temporary_password_min_12_chars
INITIAL_OWNER_FULL_NAME=Business Owner

# ------------------------------------------------------------------------------
# n8n Automation Integration
# ------------------------------------------------------------------------------
# Internal Docker or localhost network endpoint for n8n webhooks
N8N_INTERNAL_URL=http://localhost:5678
N8N_LEAD_WEBHOOK_PATH=/webhook/roofing-lead-created
# Shared secret sent via header (X-Webhook-Secret) to authenticate calls between backend & n8n
N8N_WEBHOOK_SECRET=replace_with_random_shared_webhook_secret_key

# ------------------------------------------------------------------------------
# n8n Container Internal Configuration (Docker VPS Deployment)
# ------------------------------------------------------------------------------
N8N_PORT=5678
# n8n basic auth or owner account for internal access (NEVER expose editor to public internet)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=n8n_admin
N8N_BASIC_AUTH_PASSWORD=replace_with_strong_n8n_admin_password
N8N_ENCRYPTION_KEY=replace_with_random_n8n_encryption_key

# ------------------------------------------------------------------------------
# Frontend Public Environment Variables (Vite)
# ------------------------------------------------------------------------------
# These are exposed to the browser bundle during build time. NEVER put secrets here.
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_COMPANY_NAME="Apex Roofing Solutions"
VITE_DEFAULT_PHONE="(555) 123-4567"
VITE_DEFAULT_EMAIL="info@apexroofingexample.com"
