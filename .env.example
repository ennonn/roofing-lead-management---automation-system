# ==============================================================================
# Roofing Lead Management & Automation System — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env on the target host: `cp .env.example .env`
# 2. Set strict permissions: `chmod 600 .env`
# 3. Fill in all client-specific variables and generate cryptographically secure secrets.
# 4. NEVER commit real production .env files, customer data, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Client Deployment & Stack Isolation
# ------------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME provides unique naming prefixes for Docker containers,
# networks, and persistent data volumes. Use lowercase alphanumeric + underscores
# (e.g., 'summit_roofing', 'apex_roofing').
COMPOSE_PROJECT_NAME=roofing

# ------------------------------------------------------------------------------
# 2. Server & Environment
# ------------------------------------------------------------------------------
# Must be 'production' on deployed environments to activate production security gates.
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Public domain name pointing to this server (e.g. 'summitroofingpros.com' or 'localhost')
DOMAIN_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Exact public frontend origin for CORS and cookie SameSite matching (https://<DOMAIN_NAME>)
CLIENT_ORIGIN=http://localhost

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (Drizzle ORM & Session Store)
# ------------------------------------------------------------------------------
# In Docker Compose, the database host is the internal service name 'db'.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=roofing_leads
POSTGRES_USER=roofing_user
# Generate a strong password: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_strong_database_password_here

# Full connection string used by Drizzle ORM migration scripts
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 4. Session & Security Settings
# ------------------------------------------------------------------------------
# SESSION_SECRET must be a cryptographically random string (min 32 characters in production)
# Generate via: openssl rand -hex 32
SESSION_SECRET=replace_with_random_32_character_string_for_session_cookie_encryption
SESSION_NAME=roofing_sid
SESSION_MAX_AGE_HOURS=24
# Set to 'true' in production behind HTTPS reverse proxy
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 5. Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# ------------------------------------------------------------------------------
# 6. Initial Owner Seed (Private Administrative Provisioning)
# ------------------------------------------------------------------------------
# Used ONLY during initial database seed (`npm run db:seed`) to provision the business owner.
INITIAL_OWNER_EMAIL=owner@example-roofing.com
# Must be >= 12 characters in production. Generate via: openssl rand -base64 16
INITIAL_OWNER_PASSWORD=replace_with_initial_temporary_password_min_12_chars
INITIAL_OWNER_FULL_NAME=Business Owner

# ------------------------------------------------------------------------------
# 7. Client Operational Identity & Branding
# ------------------------------------------------------------------------------
# Embedded into frontend bundle during build and used to seed backend business settings.
COMPANY_NAME="Apex Roofing Solutions"
COMPANY_TAGLINE="Professional Roofing & Storm Damage Restoration"
COMPANY_PHONE="(555) 123-4567"
# Emergency phone for urgent storm/leak response. If omitted or empty (""),
# emergency banners and direct emergency calling links are cleanly hidden.
COMPANY_EMERGENCY_PHONE="(555) 999-HELP"
COMPANY_EMAIL="contact@apexroofingexample.com"
COMPANY_DISPATCH_EMAIL="dispatch@apexroofingexample.com"
COMPANY_ADDRESS="100 Commercial Pkwy, Suite 200, Metro Area"
COMPANY_LICENSE="ROOF-LIC-10928"
# Comma-separated list of service areas served by this client
COMPANY_SERVICE_AREAS="Metro Area, North County, South County, East Suburbs, West Suburbs"

# Business hours displayed across the public website and contact views
VITE_HOURS_WEEKDAYS="7:00 AM - 6:00 PM"
VITE_HOURS_SATURDAY="8:00 AM - 2:00 PM"
VITE_HOURS_SUNDAY="Emergency Storm Response Only"

# ------------------------------------------------------------------------------
# 8. Client Notification Destinations (n8n & Outbound Dispatch)
# ------------------------------------------------------------------------------
# Destination email address where instant lead alerts are delivered to company staff
STAFF_NOTIFICATION_EMAIL="owner@example-roofing.com"
# Outbound sender email address configured in client SMTP/transactional email provider
SMTP_DISPATCH_FROM="notifications@clientdomain.com"

# ------------------------------------------------------------------------------
# 9. n8n Automation Engine Integration
# ------------------------------------------------------------------------------
# Internal Docker or localhost endpoint for n8n webhooks
N8N_INTERNAL_URL=http://localhost:5678
N8N_LEAD_WEBHOOK_PATH=/webhook/roofing-lead-created
# Shared secret sent via header (X-Webhook-Secret) to authenticate calls between backend & n8n
# Generate via: openssl rand -hex 32
N8N_WEBHOOK_SECRET=replace_with_random_shared_webhook_secret_key

# ------------------------------------------------------------------------------
# 10. n8n Container Internal Configuration (Docker VPS Deployment)
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST_PORT=5678
# n8n editor access control (bound exclusively to 127.0.0.1; access via SSH tunnel only)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=n8n_admin
# Generate via: openssl rand -base64 16
N8N_BASIC_AUTH_PASSWORD=replace_with_strong_n8n_admin_password
# Generate via: openssl rand -hex 24
N8N_ENCRYPTION_KEY=replace_with_random_n8n_encryption_key

# ------------------------------------------------------------------------------
# 11. Frontend Public API Endpoint (Vite)
# ------------------------------------------------------------------------------
# Relative path when served behind reverse proxy, or full URL for local development
VITE_API_BASE_URL=/api/v1
