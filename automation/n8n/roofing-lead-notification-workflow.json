      "id": "node-webhook-trigger",
      "name": "Webhook: Lead Created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ],
      "webhookId": "roofing-lead-created",
      "credentials": {
        "httpHeaderAuth": {
          "id": "HEADER_AUTH_CREDENTIAL_ID",
          "name": "Roofing Webhook Auth"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Extract headers and body\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst body = item.json.body || {};\n\n// 1. Verify header presence (authentication is enforced natively at Webhook boundary via Header Auth credential)\nconst receivedSecret = headers['x-webhook-secret'] || headers['X-Webhook-Secret'];\nif (!receivedSecret) {\n  return [{\n    json: {\n      isValid: false,\n      statusCode: 401,\n      errorCode: 'UNAUTHORIZED',\n      errorMessage: 'Invalid or missing X-Webhook-Secret authentication header'\n    }\n  }];\n}\n\n// 2. Strict UUID v4 regex validation for Idempotency Key\nconst idempotencyKey = String(headers['x-idempotency-key'] || headers['X-Idempotency-Key'] || '').trim();\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!uuidRegex.test(idempotencyKey)) {\n  return [{\n    json: {\n      isValid: false,\n      statusCode: 422,\n      errorCode: 'INVALID_IDEMPOTENCY_KEY',\n      errorMessage: 'X-Idempotency-Key must be a valid UUID string'\n    }\n  }];\n}\n\n// 3. Strict UUID v4 regex validation for Lead ID\nconst leadId = String(body.leadId || '').trim();\nif (!uuidRegex.test(leadId)) {\n  return [{\n    json: {\n      isValid: false,\n      statusCode: 422,\n      errorCode: 'INVALID_LEAD_ID',\n      errorMessage: 'leadId must be a valid UUID string'\n    }\n  }];\n}\n\n// 4. Validate and Sanitize Required Lead Payload Fields\nconst customerName = String(body.customerName || '').trim();\nconst phone = String(body.phone || '').trim();\nconst serviceType = String(body.serviceType || '').trim();\nconst propertyLocation = String(body.propertyLocation || '').trim();\n\nif (!customerName || !phone || !serviceType || !propertyLocation) {\n  return [{\n    json: {\n      isValid: false,\n      statusCode: 422,\n      errorCode: 'INVALID_PAYLOAD',\n      errorMessage: 'Missing required payload fields: customerName, phone, serviceType, or propertyLocation'\n    }\n  }];\n}\n\n// 5. Sanitize Optional & Operational Metadata Fields\nconst email = body.email ? String(body.email).trim() : null;\nconst projectDescription = String(body.projectDescription || '').trim();\nconst preferredContactMethod = String(body.preferredContactMethod || 'phone').trim();\nconst leadSource = String(body.leadSource || 'website_quote_form').trim();\nconst submissionDate = body.submissionDate ? String(body.submissionDate).trim() : new Date().toISOString();\nconst companyName = String(body.companyName || 'Apex Roofing Solutions').trim();\nconst dispatchEmail = String(body.dispatchEmail || 'dispatch@roofingcompany.com').trim();\nconst staffNotificationEmail = String(body.staffNotificationEmail || 'leads@roofingcompany.com').trim();\n\nreturn [{\n  json: {\n    isValid: true,\n    idempotencyKey,\n    leadId,\n    customerName,\n    phone,\n    email,\n    serviceType,\n    propertyLocation,\n    projectDescription,\n    preferredContactMethod,\n    leadSource,\n    submissionDate,\n    companyName,\n    dispatchEmail,\n    staffNotificationEmail\n  }\n}];"
      },
